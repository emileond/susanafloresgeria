{
  // App de expedientes (privada). Se sirve detrás de Cloudflare Access en app.susanafloresgeria.com.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "susanafloresgeria-app",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Solo se publica en el dominio protegido por Access (sin *.workers.dev ni URLs de vista previa).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.susanafloresgeria.com", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "susanafloresgeria-app",
      "database_id": "39510c56-352d-4224-be75-85b221e38323",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "susanafloresgeria-files" },
    { "binding": "BACKUPS", "bucket_name": "susanafloresgeria-backups" }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Dominio del equipo de Cloudflare Zero Trust, p. ej. "susanaflores.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "umbrelhome.cloudflareaccess.com",
    // "Application Audience (AUD) Tag" de la aplicación de Access
    "ACCESS_AUD": "b7b1633cceb66e63b3aa3e2eccd922a3e296ef6265bf02f91bcfdee0f445638a",
    // El correo que se da de alta como administradora en su primer acceso va como secreto
    // (el repositorio es público): `wrangler secret put BOOTSTRAP_ADMIN_EMAIL`.
    // Escalas con licencia habilitadas, separadas por coma (p. ej. "mna-sf,zarit"), una vez confirmados sus términos de uso
    "LICENSED_SCALES": "",
    // Asistente de IA (historia clínica). La clave va como secreto: `wrangler secret put ANTHROPIC_API_KEY`.
    "AI_MODEL": "claude-haiku-5-5",
    // URL de Cloudflare AI Gateway para Anthropic: https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY>/anthropic
    "AI_GATEWAY_URL": "",
    // Enlace "Abrir en Doctoralia" cuando el evento no trae uno propio (p. ej. la agenda del panel de Doctoralia)
    "DOCTORALIA_CALENDAR_URL": "https://www.doctoralia.com.mx"
    // La dirección iCal privada del calendario va como secreto: `wrangler secret put DOCTORALIA_ICS_URL`
  },
  // Tareas programadas: sincronizar Doctoralia cada 15 min y respaldo diario (09:00 UTC = 03:00 en León)
  "triggers": {
    "crons": ["*/15 * * * *", "0 9 * * *"]
  },
  // Límite de uso del asistente de IA por usuario (Workers Rate Limiting)
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
