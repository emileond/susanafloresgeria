# Copie este archivo como .dev.vars para desarrollo local (no se sube al repositorio).
ENVIRONMENT=development
# En local no hay Cloudflare Access: se usa este usuario de prueba.
DEV_USER_EMAIL=doctora@example.com
# Opcional: clave de Anthropic para probar el llenado de historia clínica con IA (vacío = desactivado)
ANTHROPIC_API_KEY=
# Opcional: dirección iCal privada del calendario con las citas de Doctoralia (vacío = sin sincronizar)
DOCTORALIA_ICS_URL=
# Solo producción (secreto): correo que se da de alta como administradora en su primer acceso
BOOTSTRAP_ADMIN_EMAIL=
