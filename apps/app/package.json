{
  "name": "@susanafloresgeria/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "wrangler deploy",
    "check": "tsc -b",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed/dev-seed.sql",
    "cf-typegen": "wrangler types --strict-vars=false src/worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^7.0.2",
    "@susanafloresgeria/theme": "*",
    "@tanstack/react-query": "^5.106.0",
    "@tanstack/react-router": "^1.170.46",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.157.0"
  }
}
