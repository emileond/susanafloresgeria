---
// Palabra con un subrayado "dibujado a mano", como acento cálido en títulos.
interface Props {
  color?: string;
}
const { color = 'var(--color-accent)' } = Astro.props;
---

<span class="relative inline-block whitespace-nowrap">
  <span class="relative z-10"><slot /></span>
  <svg
    aria-hidden="true"
    viewBox="0 0 200 16"
    preserveAspectRatio="none"
    class="absolute -bottom-1.5 left-0 z-0 h-3.5 w-full sm:h-4"
    fill="none"
  >
    <path d="M3 11c38-6 92-9 194-4" stroke={color} stroke-width="7" stroke-linecap="round"></path>
  </svg>
</span>
