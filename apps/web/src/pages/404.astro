---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada">
  <section class="container-page py-24 text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-4 text-4xl sm:text-5xl">No encontramos esta página</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-muted">Es posible que el enlace haya cambiado. Puede volver al inicio o leer nuestras guías.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Ir al inicio</a>
      <a href="/blog/" class="btn btn-outline">Ver el blog</a>
    </div>
  </section>
</Base>
