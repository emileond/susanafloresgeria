---
import CalendarCheck from '@lucide/astro/icons/calendar-check';
---

<!-- Barra fija en móvil: la acción principal siempre a un toque -->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 px-3 pt-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] shadow-[0_-8px_24px_-12px_rgba(31,28,58,0.25)] backdrop-blur lg:hidden"
>
  <div class="mx-auto max-w-md">
    <a href="/#agendar" class="btn btn-primary w-full">
      <CalendarCheck aria-hidden="true" />
      Agendar cita
    </a>
  </div>
</div>
