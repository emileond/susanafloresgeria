---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import { getSortedPosts } from '../../lib/blog';

const posts = await getSortedPosts();
---

<Base
  title="Guías para familias y cuidadores"
  description="Artículos prácticos de la Dra. Susana Flores, geriatra en León, para cuidar mejor a las personas mayores en casa: memoria, caídas, medicamentos y más."
>
  <section class="container-page py-14 sm:py-20">
    <header class="max-w-2xl">
      <p class="eyebrow">Blog</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">Guías para familias y cuidadores</h1>
      <p class="mt-4 text-lg text-muted sm:text-xl">
        Consejos prácticos y claros para acompañar a su familiar mayor en casa.
      </p>
    </header>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => <PostCard post={p} index={i} />)}
    </div>

    <div class="mt-16">
      <BookingCTA />
    </div>
  </section>
</Base>
